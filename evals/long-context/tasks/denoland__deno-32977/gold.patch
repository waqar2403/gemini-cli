From 802c90939d6ac91a6607290123cf61af1373ffae Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bartek=20Iwa=C5=84czuk?= <biwanczuk@gmail.com>
Date: Wed, 25 Mar 2026 08:22:27 +0100
Subject: [PATCH 1/4] fix(resolver): prefer exact version match in BYONM npm
 resolution

When resolving npm packages in BYONM (nodeModulesDir: "manual") mode,
the resolver scans node_modules/.deno/ for matching versions and returns
the highest one that satisfies the version requirement. This causes
`deno run npm:pkg@1.3.5` to pick a higher cached version (e.g. 1.3.6)
instead of the exact requested version.

Fix: when the version requirement text parses as an exact version and
matches a directory entry exactly, prefer that match and stop searching.
This ensures `npm:pkg@1.3.5` returns 1.3.5 when it exists, not a higher
version.

Fixes #32972

Co-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
---
 libs/resolver/npm/byonm.rs | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/libs/resolver/npm/byonm.rs b/libs/resolver/npm/byonm.rs
index c55890cfd190a7..e10cc2ecf16059 100644
--- a/libs/resolver/npm/byonm.rs
+++ b/libs/resolver/npm/byonm.rs
@@ -368,6 +368,17 @@ impl<TSys: ByonmNpmResolverSys> ByonmNpmResolver<TSys> {
           }
         }
       } else if req.version_req.matches(&version) {
+        // Prefer an exact version match over the highest matching version.
+        // When a user specifies `npm:pkg@1.3.5`, the version_text is "1.3.5"
+        // and we should return that exact version if it exists, not a higher
+        // one that also satisfies the range.
+        let is_exact =
+          Version::parse_from_npm(req.version_req.version_text())
+            .is_ok_and(|v| v == version);
+        if is_exact {
+          best_version = Some((version, entry_name));
+          break;
+        }
         if let Some((best_version_version, _)) = &best_version {
           if version > *best_version_version {
             best_version = Some((version, entry_name));

