+func SetUserSettingJSON[T any](ctx context.Context, userID int64, key string, def T)  error {
+	str, err := json.Marshal(def)
+	if err != nil {
+		return err
+	}
+	return SetUserSetting(ctx, userID, key, util.UnsafeBytesToString(str))
+}
