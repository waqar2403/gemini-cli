+func GetUserSettingJSON[T any](ctx context.Context, userID int64, key string, def T) (ret T, _ error) {
+	ret = def
+	str, err := GetUserSetting(ctx, userID, key)
+	if err != nil {
+		return ret, err
+	}
+	if str == "" {
+		return ret, nil
+	}
+	err = json.Unmarshal(util.UnsafeStringToBytes(str), &ret)
+	return ret, err
