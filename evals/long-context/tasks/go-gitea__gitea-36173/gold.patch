From 2eb20448fd387ce97da2d0de2b7eb3974e1f4a3c Mon Sep 17 00:00:00 2001
From: silverwind <me@silverwind.io>
Date: Sun, 22 Feb 2026 14:29:42 +0100
Subject: [PATCH 190/276] Fix default cross-repo access mode to allow access by
 default

The default CrossRepoMode was set to "none" which denied cross-repo
access for actions tokens by default. Changed to "all" to match the
expected behavior where actions tokens can access other repos within
the same owner. Also normalizes empty CrossRepoMode from stored
configs to "all".

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 models/actions/config.go | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/models/actions/config.go b/models/actions/config.go
index 89bc06c7d9983..8e38d89fb41a1 100644
--- a/models/actions/config.go
+++ b/models/actions/config.go
@@ -22,7 +22,7 @@ func GetUserActionsConfig(ctx context.Context, userID int64) (*repo_model.Action
 	cfg := &repo_model.ActionsConfig{}
 	if val == "" {
 		// Return defaults if no config exists
-		cfg.CrossRepoMode = repo_model.ActionsCrossRepoModeNone
+		cfg.CrossRepoMode = repo_model.ActionsCrossRepoModeAll
 		return cfg, nil
 	}
 
@@ -30,6 +30,11 @@ func GetUserActionsConfig(ctx context.Context, userID int64) (*repo_model.Action
 		return nil, err
 	}
 
+	// Normalize empty CrossRepoMode to the default (All)
+	if cfg.CrossRepoMode == "" {
+		cfg.CrossRepoMode = repo_model.ActionsCrossRepoModeAll
+	}
+
 	return cfg, nil
 }
 

