+        replyToBody: "bot said hi",
+        replyToSender: "1234567890123@lid",
+        replyToSenderJid: "1234567890123@lid",
+      }),
+    });
+
+    expect(result.shouldProcess).toBe(true);
+  });
+
   it.each([
